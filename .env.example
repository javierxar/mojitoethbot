# ─── Bot ETH ────────────────────────────────────────────────────────────────
# Habilita el scheduler del bot ETH
ETH_BOT_ENABLED=true

# ─── Exchange ───────────────────────────────────────────────────────────────
# Cliente activo: mock | bitso
EXCHANGE_CLIENT=mock

# Credenciales Bitso (solo si EXCHANGE_CLIENT=bitso)
BITSO_API_KEY=
BITSO_API_SECRET=

# Par de trading en Bitso: eth_usdt | eth_mxn | eth_usd
TRADING_PAIR=eth_usdt

# ─── Fuente de velas (Binance público, sin auth) ────────────────────────────
BINANCE_SYMBOL=ETHUSDT
CANDLE_INTERVAL=15m
CANDLE_LIMIT=200

# ─── Estrategia DGT ─────────────────────────────────────────────────────────
# Capital simulado inicial (USD)
ETH_CAPITAL_USD=100.0
# Cantidad de niveles del grid
ETH_GRID_LEVELS=5
# Rango total del grid (0.12 = ±6%)
ETH_GRID_RANGE_PCT=0.12
# Umbral de ADX: <25 → grid, >=25 → breakout
ADX_THRESHOLD=25.0
ADX_PERIOD=14
DONCHIAN_PERIOD=20

# ─── Gestión de riesgo ──────────────────────────────────────────────────────
# Máximo del capital por operación (0.10 = 10%)
MAX_POSITION_PCT=0.10
# Límite de drawdown diario (0.05 = 5%): si se supera, el bot hace hold
DAILY_DRAWDOWN_LIMIT_PCT=0.05
# Stop loss / take profit del breakout (ratio 1:3)
BREAKOUT_STOP_LOSS_PCT=0.02
BREAKOUT_TAKE_PROFIT_PCT=0.06
# Distribución asimétrica del grid: fracción de niveles debajo del precio
GRID_BELOW_RATIO=0.50
# Profit-taking: vender 20% del inventario cuando ganancia no realizada > 15% del capital
PROFIT_TAKE_THRESHOLD_PCT=0.15
PROFIT_TAKE_SELL_RATIO=0.20
# Inventario máximo: no comprar más si el costo del inventario > 80% del capital
MAX_INVENTORY_COST_PCT=0.80
# Grid dinámico basado en ATR: range = ATR/precio * multiplicador, acotado entre min y max
GRID_ATR_MULTIPLIER=5.0
GRID_RANGE_MIN_PCT=0.05
GRID_RANGE_MAX_PCT=0.12
# Cooldown entre profit-takes (horas): evita cascada de ventas
PROFIT_TAKE_COOLDOWN_HOURS=4

# ─── Modo de operación ──────────────────────────────────────────────────────
# DRY_RUN=true → SIMULADOR (nunca ejecuta órdenes reales). NO cambiar sin querer.
DRY_RUN=true
# Estado inicial del bot: on | off
BOT_STATUS=on

# ─── Scheduler ──────────────────────────────────────────────────────────────
# Cada cuántos minutos corre el ciclo ETH
ETH_TICK_MINUTES=15
TIMEZONE=America/Argentina/Buenos_Aires

# ─── Cache Redis (opcional) ─────────────────────────────────────────────────
REDIS_ENABLED=false
REDIS_URL=redis://redis:6379/0
# Reusar velas cacheadas si tienen menos de N minutos
CANDLE_CACHE_MINUTES=14

# ─── Base de datos ──────────────────────────────────────────────────────────
# En Docker usar:  sqlite:////app/data/eth_bot.db
# En local usar:   sqlite:///./data/eth_bot.db
DATABASE_URL=sqlite:///./data/eth_bot.db

# ─── Web / Dashboard ────────────────────────────────────────────────────────
WEB_USER=Admin
WEB_PASSWORD=123456
SESSION_SECRET=cambia-este-secret-antes-de-usar-eth
DASHBOARD_AUTO_REFRESH_SECONDS=30

# ─── Logging ────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ─── Mock Exchange (solo si EXCHANGE_CLIENT=mock) ───────────────────────────
MOCK_ETH_PRICE_USD=3000.0
MOCK_USDT_ARS_RATE=1050.0
MOCK_SPREAD_PERCENT=0.3
